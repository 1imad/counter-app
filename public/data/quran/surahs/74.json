      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5497,
      "numberInSurah": 2,
      "arabic": "قُمْ فَأَنذِرْ",
      "translation": "Arise and warn",
