{
  "number": 74,
  "name": "سُورَةُ المُدَّثِّرِ",
  "englishName": "Al-Muddaththir",
  "englishNameTranslation": "The Cloaked One",
  "revelationType": "Meccan",
  "numberOfAyahs": 56,
  "ayahs": [
    {
      "number": 5496,
      "numberInSurah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ يَٰٓأَيُّهَا ٱلْمُدَّثِّرُ",
