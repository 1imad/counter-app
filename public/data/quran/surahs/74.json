      "juz": 29,
      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5500,
      "numberInSurah": 5,
      "arabic": "وَٱلرُّجْزَ فَٱهْجُرْ",
