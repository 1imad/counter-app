      "manzil": 7,
      "page": 575,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5502,
      "numberInSurah": 7,
      "arabic": "وَلِرَبِّكَ فَٱصْبِرْ",
