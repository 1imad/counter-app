{
  "number": 96,
  "name": "سُورَةُ العَلَقِ",
  "englishName": "Al-Alaq",
  "englishNameTranslation": "The Clot",
  "revelationType": "Meccan",
  "numberOfAyahs": 19,
  "ayahs": [
    {
      "number": 6107,
      "numberInSurah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "translation": "Recite in the name of your Lord who created -",
      "transliteration": "Iqra bismi rab bikal lazee khalaq",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "(اے محمدﷺ) اپنے پروردگار کا نام لے کر پڑھو جس نے (عالم کو) پیدا کیا"
    },
    {
      "number": 6108,
      "numberInSurah": 2,
      "arabic": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ",
      "translation": "Created man from a clinging substance.",
      "transliteration": "Khalaqal insaana min 'alaq",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "جس نے انسان کو خون کی پھٹکی سے بنایا"
    },
    {
      "number": 6109,
      "numberInSurah": 3,
      "arabic": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "translation": "Recite, and your Lord is the most Generous -",
      "transliteration": "Iqra wa rab bukal akram",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "پڑھو اور تمہارا پروردگار بڑا کریم ہے"
    },
    {
      "number": 6110,
      "numberInSurah": 4,
      "arabic": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "translation": "Who taught by the pen -",
      "transliteration": "Al lazee 'allama bil qalam",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "جس نے قلم کے ذریعے سے علم سکھایا"
    },
    {
      "number": 6111,
      "numberInSurah": 5,
      "arabic": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ",
      "translation": "Taught man that which he knew not.",
      "transliteration": "'Al lamal insaana ma lam y'alam",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "اور انسان کو وہ باتیں سکھائیں جس کا اس کو علم نہ تھا"
    },
    {
      "number": 6112,
      "numberInSurah": 6,
      "arabic": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ",
      "translation": "No! [But] indeed, man transgresses",
      "transliteration": "Kallaa innal insaana layatghaa",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "مگر انسان سرکش ہو جاتا ہے"
    },
    {
      "number": 6113,
      "numberInSurah": 7,
      "arabic": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "translation": "Because he sees himself self-sufficient.",
      "transliteration": "Ar-ra aahus taghnaa",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "جب کہ اپنے تیئں غنی دیکھتا ہے"
    },
    {
      "number": 6114,
      "numberInSurah": 8,
      "arabic": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
      "translation": "Indeed, to your Lord is the return.",
      "transliteration": "Innna ilaa rabbikar ruj'aa",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "کچھ شک نہیں کہ (اس کو) تمہارے پروردگار ہی کی طرف لوٹ کر جانا ہے"
    },
    {
      "number": 6115,
      "numberInSurah": 9,
      "arabic": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
      "translation": "Have you seen the one who forbids",
      "transliteration": "Ara-aital lazee yanhaa",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "بھلا تم نے اس شخص کو دیکھا جو منع کرتا ہے"
    },
    {
      "number": 6116,
      "numberInSurah": 10,
      "arabic": "عَبْدًا إِذَا صَلَّىٰٓ",
      "translation": "A servant when he prays?",
      "transliteration": "'Abdan iza sallaa",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "(یعنی) ایک بندے کو جب وہ نماز پڑھنے لگتا ہے"
    },
    {
      "number": 6117,
      "numberInSurah": 11,
      "arabic": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
      "translation": "Have you seen if he is upon guidance",
      "transliteration": "Ara-aita in kana 'alal hudaa",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "بھلا دیکھو تو اگر یہ راہِ راست پر ہو"
    },
    {
      "number": 6118,
      "numberInSurah": 12,
      "arabic": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
      "translation": "Or enjoins righteousness?",
      "transliteration": "Au amara bit taqwaa",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "یا پرہیز گاری کا حکم کرے (تو منع کرنا کیسا)"
    },
    {
      "number": 6119,
      "numberInSurah": 13,
      "arabic": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "translation": "Have you seen if he denies and turns away -",
      "transliteration": "Ara-aita in kaz zaba wa ta walla",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "اور دیکھو تو اگر اس نے دین حق کو جھٹلایا اور اس سے منہ موڑا (تو کیا ہوا)"
    },
    {
      "number": 6120,
      "numberInSurah": 14,
      "arabic": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "translation": "Does he not know that Allah sees?",
      "transliteration": "Alam y'alam bi-an nal lahaa yaraa",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "کیااس کو معلوم نہیں کہ خدا دیکھ رہا ہے"
    },
    {
      "number": 6121,
      "numberInSurah": 15,
      "arabic": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
      "translation": "No! If he does not desist, We will surely drag him by the forelock -",
      "transliteration": "Kalla la illam yantahi la nasfa'am bin nasiyah",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "دیکھو اگر وہ باز نہ آئے گا تو ہم (اس کی) پیشانی کے بال پکڑ گھسیٹیں گے"
    },
    {
      "number": 6122,
      "numberInSurah": 16,
      "arabic": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ",
      "translation": "A lying, sinning forelock.",
      "transliteration": "Nasiyatin kazi batin khaatiyah",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "یعنی اس جھوٹے خطاکار کی پیشانی کے بال"
    },
    {
      "number": 6123,
      "numberInSurah": 17,
      "arabic": "فَلْيَدْعُ نَادِيَهُۥ",
      "translation": "Then let him call his associates;",
      "transliteration": "Fal yad'u naadiyah",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "تو وہ اپنے یاروں کی مجلس کو بلالے"
    },
    {
      "number": 6124,
      "numberInSurah": 18,
      "arabic": "سَنَدْعُ ٱلزَّبَانِيَةَ",
      "translation": "We will call the angels of Hell.",
      "transliteration": "Sanad 'uz zabaaniyah",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false,
      "urduTranslation": "ہم بھی اپنے موکلانِ دوزخ کو بلا لیں گے"
    },
    {
      "number": 6125,
      "numberInSurah": 19,
      "arabic": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
      "translation": "No! Do not obey him. But prostrate and draw near [to Allah].",
      "transliteration": "Kalla; la tuti'hu wasjud waqtarib",
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": {
        "id": 15,
        "recommended": false,
        "obligatory": true
      },
      "urduTranslation": "دیکھو اس کا کہا نہ ماننا اور قربِ (خدا) حاصل کرتے رہنا"
    }
  ]
}