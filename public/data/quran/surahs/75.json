      "transliteration": "Wujoohuny yawma 'izin naadirah",
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5574,
      "numberInSurah": 23,
      "arabic": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ",
      "translation": "Looking at their Lord.",
      "transliteration": "Ilaa rabbihaa naazirah",
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5575,
      "numberInSurah": 24,
      "arabic": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ",
      "translation": "And [some] faces, that Day, will be contorted,",
      "transliteration": "Wa wujoohuny yawma 'izim baasirah",
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5576,
      "numberInSurah": 25,
      "arabic": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ",
      "translation": "Expecting that there will be done to them [something] backbreaking.",
