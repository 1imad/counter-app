      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5577,
      "numberInSurah": 26,
      "arabic": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ",
      "translation": "No! When the soul has reached the collar bones",
      "transliteration": "Kallaaa izaa balaghatit taraaqee",
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5578,
      "numberInSurah": 27,
      "arabic": "وَقِيلَ مَنْ ۜ رَاقٍۢ",
      "translation": "And it is said, \"Who will cure [him]?\"",
      "transliteration": "Wa qeela man raaq",
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
