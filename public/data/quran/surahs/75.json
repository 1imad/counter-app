{
  "number": 75,
  "name": "سُورَةُ القِيَامَةِ",
  "englishName": "Al-Qiyaama",
  "englishNameTranslation": "The Resurrection",
  "revelationType": "Meccan",
  "numberOfAyahs": 40,
  "ayahs": [
    {
      "number": 5552,
      "numberInSurah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ",
      "translation": "I swear by the Day of Resurrection",
      "transliteration": "Laaa uqsimu bi yawmil qiyaamah",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5553,
      "numberInSurah": 2,
      "arabic": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
      "translation": "And I swear by the reproaching soul [to the certainty of resurrection].",
      "transliteration": "Wa laaa uqsimu bin nafsil lawwaamah",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5554,
      "numberInSurah": 3,
      "arabic": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
      "translation": "Does man think that We will not assemble his bones?",
      "transliteration": "Ayahsabul insaanu al lan najm'a 'izaamah",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5555,
      "numberInSurah": 4,
      "arabic": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
      "translation": "Yes. [We are] Able [even] to proportion his fingertips.",
      "transliteration": "Balaa qaadireena 'alaaa an nusawwiya banaanah",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5556,
      "numberInSurah": 5,
      "arabic": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ",
      "translation": "But man desires to continue in sin.",
      "transliteration": "Bal yureedul insaanu liyafjura amaamah",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5557,
      "numberInSurah": 6,
      "arabic": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ",
      "translation": "He asks, \"When is the Day of Resurrection?\"",
      "transliteration": "Yas'alu ayyyaana yawmul qiyaamah",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5558,
      "numberInSurah": 7,
      "arabic": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
      "translation": "So when vision is dazzled",
      "transliteration": "Fa izaa bariqal basar",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5559,
      "numberInSurah": 8,
      "arabic": "وَخَسَفَ ٱلْقَمَرُ",
      "translation": "And the moon darkens",
      "transliteration": "We khasafal qamar",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5560,
      "numberInSurah": 9,
      "arabic": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
      "translation": "And the sun and the moon are joined,",
      "transliteration": "Wa jumi'ash shamusu wal qamar",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5561,
      "numberInSurah": 10,
      "arabic": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
      "translation": "Man will say on that Day, \"Where is the [place of] escape?\"",
      "transliteration": "Yaqoolul insaanu yaw ma 'izin aynal mafarr",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5562,
      "numberInSurah": 11,
      "arabic": "كَلَّا لَا وَزَرَ",
      "translation": "No! There is no refuge.",
      "transliteration": "Kallaa laa wazar",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5563,
      "numberInSurah": 12,
      "arabic": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
      "translation": "To your Lord, that Day, is the [place of] permanence.",
      "transliteration": "Ilaa rabbika yawma 'izinil mustaqarr",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5564,
      "numberInSurah": 13,
      "arabic": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "translation": "Man will be informed that Day of what he sent ahead and kept back.",
      "transliteration": "Yunabba 'ul insaanu yawma 'izim bimaa qaddama wa akhkhar",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5565,
      "numberInSurah": 14,
      "arabic": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ",
      "translation": "Rather, man, against himself, will be a witness,",
      "transliteration": "Balil insaanu 'alaa nafsihee baseerah",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5566,
      "numberInSurah": 15,
      "arabic": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
      "translation": "Even if he presents his excuses.",
      "transliteration": "Wa law alqaa ma'aazeerah",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5567,
      "numberInSurah": 16,
      "arabic": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
      "translation": "Move not your tongue with it, [O Muhammad], to hasten with recitation of the Qur'an.",
      "transliteration": "Laa tuharrik bihee lisaa naka lita'jala bih",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5568,
      "numberInSurah": 17,
      "arabic": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
      "translation": "Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation.",
      "transliteration": "Inna 'alainaa jam'ahoo wa qur aanah",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5569,
      "numberInSurah": 18,
      "arabic": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
      "translation": "So when We have recited it [through Gabriel], then follow its recitation.",
      "transliteration": "Fa izaa qaraanaahu fattabi' qur aanah",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5570,
      "numberInSurah": 19,
      "arabic": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
      "translation": "Then upon Us is its clarification [to you].",
      "transliteration": "Summa inna 'alainaa bayaanah",
      "juz": 29,
      "manzil": 7,
      "page": 577,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5571,
      "numberInSurah": 20,
      "arabic": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ",
      "translation": "No! But you love the immediate",
      "transliteration": "Kallaa bal tuhibboonal 'aajilah",
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5572,
      "numberInSurah": 21,
      "arabic": "وَتَذَرُونَ ٱلْءَاخِرَةَ",
      "translation": "And leave the Hereafter.",
      "transliteration": "Wa tazaroonal Aakhirah",
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5573,
      "numberInSurah": 22,
      "arabic": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ",
