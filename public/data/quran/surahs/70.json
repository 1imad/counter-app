{
  "number": 70,
  "name": "سُورَةُ المَعَارِجِ",
  "englishName": "Al-Ma'aarij",
  "englishNameTranslation": "The Ascending Stairways",
  "revelationType": "Meccan",
  "numberOfAyahs": 44,
  "ayahs": [
    {
      "number": 5376,
      "numberInSurah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ",
      "translation": "A supplicant asked for a punishment bound to happen",
      "transliteration": "Sa ala saaa'ilum bi'azaa binw-waaqi'",
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5377,
      "numberInSurah": 2,
      "arabic": "لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌۭ",
      "translation": "To the disbelievers; of it there is no preventer.",
      "transliteration": "Lilkaafireen laisa lahoo daafi'",
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5378,
      "numberInSurah": 3,
      "arabic": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ",
      "translation": "[It is] from Allah, owner of the ways of ascent.",
      "transliteration": "Minal laahi zil ma'aarij",
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5379,
      "numberInSurah": 4,
      "arabic": "تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍۢ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍۢ",
      "translation": "The angels and the Spirit will ascend to Him during a Day the extent of which is fifty thousand years.",
      "transliteration": "Ta'rujul malaaa'ikatu war Roohu ilaihi fee yawmin kaana miqdaaruhoo khamseena alfa sanah",
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5380,
      "numberInSurah": 5,
      "arabic": "فَٱصْبِرْ صَبْرًۭا جَمِيلًا",
      "translation": "So be patient with gracious patience.",
      "transliteration": "Fasbir ssabran jameelaa",
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5381,
      "numberInSurah": 6,
      "arabic": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًۭا",
      "translation": "Indeed, they see it [as] distant,",
      "transliteration": "Inaahum yarawnahoo ba'eedaa",
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5382,
      "numberInSurah": 7,
      "arabic": "وَنَرَىٰهُ قَرِيبًۭا",
      "translation": "But We see it [as] near.",
      "transliteration": "Wa naraahu qareebaa",
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5383,
      "numberInSurah": 8,
      "arabic": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ",
      "translation": "On the Day the sky will be like murky oil,",
      "transliteration": "Yawma takoonus samaaa'u kalmuhl",
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5384,
      "numberInSurah": 9,
      "arabic": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ",
      "translation": "And the mountains will be like wool,",
      "transliteration": "Wa takoonul jibaalu kal'ihn",
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5385,
      "numberInSurah": 10,
      "arabic": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا",
      "translation": "And no friend will ask [anything of] a friend,",
      "transliteration": "Wa laa yas'alu hameemun hameemaa",
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5386,
      "numberInSurah": 11,
      "arabic": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ",
      "translation": "They will be shown each other. The criminal will wish that he could be ransomed from the punishment of that Day by his children",
      "transliteration": "Yubassaroonahum; ya waddul mujrimu law yaftadee min 'azaabi yawma'izim bibaneeh",
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5387,
      "numberInSurah": 12,
      "arabic": "وَصَٰحِبَتِهِۦ وَأَخِيهِ",
      "translation": "And his wife and his brother",
      "transliteration": "Wa saahibatihee wa akheeh",
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5388,
      "numberInSurah": 13,
      "arabic": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ",
      "translation": "And his nearest kindred who shelter him",
      "transliteration": "Wa faseelathil latee tu'weeh",
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5389,
      "numberInSurah": 14,
      "arabic": "وَمَن فِى ٱلْأَرْضِ جَمِيعًۭا ثُمَّ يُنجِيهِ",
      "translation": "And whoever is on earth entirely [so] then it could save him.",
      "transliteration": "Wa man fil ardi jamee'an summa yunjeeh",
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5390,
      "numberInSurah": 15,
      "arabic": "كَلَّآ ۖ إِنَّهَا لَظَىٰ",
      "translation": "No! Indeed, it is the Flame [of Hell],",
      "transliteration": "Kallaa innahaa lazaa",
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5391,
      "numberInSurah": 16,
      "arabic": "نَزَّاعَةًۭ لِّلشَّوَىٰ",
      "translation": "A remover of exteriors.",
      "transliteration": "Nazzaa'atal lishshawaa",
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5392,
      "numberInSurah": 17,
      "arabic": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ",
      "translation": "It invites he who turned his back [on truth] and went away [from obedience]",
      "transliteration": "Tad'oo man adbara wa tawallaa",
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
