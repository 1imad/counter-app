      "arabic": "وَجَمَعَ فَأَوْعَىٰٓ",
      "translation": "And collected [wealth] and hoarded.",
      "transliteration": "W jama'a fa aw'aa",
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
