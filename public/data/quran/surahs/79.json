      "transliteration": "Wa burrizatil-jaheemu limany-yaraa.",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5749,
      "numberInSurah": 37,
      "arabic": "فَأَمَّا مَن طَغَىٰ",
      "translation": "So as for he who transgressed",
