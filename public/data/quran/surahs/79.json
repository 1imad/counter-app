{
  "number": 79,
  "name": "سُورَةُ النَّازِعَاتِ",
  "englishName": "An-Naazi'aat",
  "englishNameTranslation": "Those who drag forth",
  "revelationType": "Meccan",
  "numberOfAyahs": 46,
  "ayahs": [
    {
      "number": 5713,
      "numberInSurah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا",
      "translation": "By those [angels] who extract with violence",
      "transliteration": "Wan naazi 'aati gharqa",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5714,
      "numberInSurah": 2,
      "arabic": "وَٱلنَّٰشِطَٰتِ نَشْطًۭا",
      "translation": "And [by] those who remove with ease",
      "transliteration": "Wan naa shi taati nashta",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5715,
      "numberInSurah": 3,
      "arabic": "وَٱلسَّٰبِحَٰتِ سَبْحًۭا",
      "translation": "And [by] those who glide [as if] swimming",
      "transliteration": "Wass saabi-haati sabha",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5716,
      "numberInSurah": 4,
      "arabic": "فَٱلسَّٰبِقَٰتِ سَبْقًۭا",
      "translation": "And those who race each other in a race",
      "transliteration": "Fass saabi qaati sabqa",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5717,
      "numberInSurah": 5,
      "arabic": "فَٱلْمُدَبِّرَٰتِ أَمْرًۭا",
      "translation": "And those who arrange [each] matter,",
      "transliteration": "Fal mu dab-bi raati amra",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5718,
      "numberInSurah": 6,
      "arabic": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
      "translation": "On the Day the blast [of the Horn] will convulse [creation],",
      "transliteration": "Yawma tarjufur raajifa",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5719,
      "numberInSurah": 7,
      "arabic": "تَتْبَعُهَا ٱلرَّادِفَةُ",
      "translation": "There will follow it the subsequent [one].",
      "transliteration": "Tatba'u har raadifa",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5720,
      "numberInSurah": 8,
      "arabic": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ",
      "translation": "Hearts, that Day, will tremble,",
      "transliteration": "Quloobuny-yau maaiziw-waaji-fa",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5721,
      "numberInSurah": 9,
      "arabic": "أَبْصَٰرُهَا خَٰشِعَةٌۭ",
      "translation": "Their eyes humbled.",
      "transliteration": "Absaa ruhaa khashi'ah",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5722,
      "numberInSurah": 10,
      "arabic": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
      "translation": "They are [presently] saying, \"Will we indeed be returned to [our] former state [of life]?",
      "transliteration": "Ya qoo loona a-inna lamar doo doona fil haafirah",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5723,
      "numberInSurah": 11,
      "arabic": "أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ",
      "translation": "Even if we should be decayed bones?",
      "transliteration": "Aizaa kunna 'izaa man-nakhirah",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5724,
      "numberInSurah": 12,
      "arabic": "قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ",
      "translation": "They say, \"That, then, would be a losing return.\"",
      "transliteration": "Qaalu tilka izan karratun khaasirah.",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5725,
      "numberInSurah": 13,
      "arabic": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ",
      "translation": "Indeed, it will be but one shout,",
      "transliteration": "Fa inna ma hiya zajratuw-waahida",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5726,
      "numberInSurah": 14,
      "arabic": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
      "translation": "And suddenly they will be [alert] upon the earth's surface.",
      "transliteration": "Faizaa hum biss saahirah",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5727,
      "numberInSurah": 15,
      "arabic": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
      "translation": "Has there reached you the story of Moses? -",
      "transliteration": "Hal ataaka hadeethu Musaa",
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5728,
      "numberInSurah": 16,
      "arabic": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
      "translation": "When his Lord called to him in the sacred valley of Tuwa,",
      "transliteration": "Iz nadaahu rabbuhu bil waadil-muqad dasi tuwa",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5729,
      "numberInSurah": 17,
      "arabic": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
      "translation": "\"Go to Pharaoh. Indeed, he has transgressed.",
      "transliteration": "Izhab ilaa fir'auna innahu taghaa.",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5730,
      "numberInSurah": 18,
      "arabic": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
      "translation": "And say to him, 'Would you [be willing to] purify yourself",
      "transliteration": "Faqul hal laka ilaa-an tazakka.",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5731,
      "numberInSurah": 19,
      "arabic": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
      "translation": "And let me guide you to your Lord so you would fear [Him]?'\"",
      "transliteration": "Wa ahdi yaka ila rabbika fatakh sha",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5732,
      "numberInSurah": 20,
      "arabic": "فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ",
      "translation": "And he showed him the greatest sign,",
      "transliteration": "Fa araahul-aayatal kubra.",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5733,
      "numberInSurah": 21,
      "arabic": "فَكَذَّبَ وَعَصَىٰ",
      "translation": "But Pharaoh denied and disobeyed.",
      "transliteration": "Fa kazzaba wa asaa.",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5734,
      "numberInSurah": 22,
      "arabic": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
      "translation": "Then he turned his back, striving.",
      "transliteration": "Thumma adbara yas'aa.",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5735,
      "numberInSurah": 23,
      "arabic": "فَحَشَرَ فَنَادَىٰ",
      "translation": "And he gathered [his people] and called out",
      "transliteration": "Fa hashara fanada.",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5736,
      "numberInSurah": 24,
      "arabic": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
      "translation": "And said, \"I am your most exalted lord.\"",
      "transliteration": "Faqala ana rabbu kumul-a'laa.",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5737,
      "numberInSurah": 25,
      "arabic": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ",
      "translation": "So Allah seized him in exemplary punishment for the last and the first [transgression].",
      "transliteration": "Fa-akha zahul laahu nakalal aakhirati wal-oola.",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5738,
      "numberInSurah": 26,
      "arabic": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ",
      "translation": "Indeed in that is a warning for whoever would fear [Allah].",
      "transliteration": "Inna fee zaalika la'ibratal limaiy-yaksha",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5739,
      "numberInSurah": 27,
      "arabic": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
      "translation": "Are you a more difficult creation or is the heaven? Allah constructed it.",
      "transliteration": "A-antum a shaddu khalqan amis samaa-u banaaha.",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5740,
      "numberInSurah": 28,
      "arabic": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
      "translation": "He raised its ceiling and proportioned it.",
      "transliteration": "Raf'a sam kaha fasaw waaha",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5741,
      "numberInSurah": 29,
      "arabic": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
