      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5751,
      "numberInSurah": 39,
      "arabic": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
      "translation": "Then indeed, Hellfire will be [his] refuge.",
      "transliteration": "Fa innal jaheema hiyal maawaa.",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5752,
      "numberInSurah": 40,
      "arabic": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
      "translation": "But as for he who feared the position of his Lord and prevented the soul from [unlawful] inclination,",
      "transliteration": "Wa ammaa man khaafa maqaama Rabbihee wa nahan nafsa 'anil hawaa",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5753,
      "numberInSurah": 41,
      "arabic": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ",
      "translation": "Then indeed, Paradise will be [his] refuge.",
      "transliteration": "Fa innal jannata hiyal maawaa",
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5754,
      "numberInSurah": 42,
