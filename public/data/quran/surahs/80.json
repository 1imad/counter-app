{
  "number": 80,
  "name": "سُورَةُ عَبَسَ",
  "englishName": "Abasa",
  "englishNameTranslation": "He frowned",
  "revelationType": "Meccan",
  "numberOfAyahs": 42,
  "ayahs": [
    {
      "number": 5759,
      "numberInSurah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ",
      "translation": "The Prophet frowned and turned away",
      "transliteration": "'Abasa wa tawallaa.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5760,
      "numberInSurah": 2,
      "arabic": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
      "translation": "Because there came to him the blind man, [interrupting].",
      "transliteration": "An jaa-ahul 'a-maa",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5761,
      "numberInSurah": 3,
      "arabic": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "translation": "But what would make you perceive, [O Muhammad], that perhaps he might be purified",
      "transliteration": "Wa maa yudreeka la'allahu yaz zakkaa.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5762,
      "numberInSurah": 4,
      "arabic": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
      "translation": "Or be reminded and the remembrance would benefit him?",
      "transliteration": "Au yaz zak karu fatanfa 'ahuz zikraa.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5763,
      "numberInSurah": 5,
      "arabic": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
      "translation": "As for he who thinks himself without need,",
      "transliteration": "Amma manis taghnaa",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5764,
      "numberInSurah": 6,
      "arabic": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "translation": "To him you give attention.",
      "transliteration": "Fa-anta lahu tasaddaa",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5765,
      "numberInSurah": 7,
      "arabic": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
      "translation": "And not upon you [is any blame] if he will not be purified.",
      "transliteration": "Wa ma 'alaika allaa yaz zakka.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5766,
      "numberInSurah": 8,
      "arabic": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
      "translation": "But as for he who came to you striving [for knowledge]",
      "transliteration": "Wa amma man jaa-aka yas'a",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5767,
      "numberInSurah": 9,
      "arabic": "وَهُوَ يَخْشَىٰ",
      "translation": "While he fears [Allah],",
      "transliteration": "Wahuwa yakhshaa,",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5768,
      "numberInSurah": 10,
      "arabic": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
      "translation": "From him you are distracted.",
      "transliteration": "Fa-anta 'anhu talah haa.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5769,
      "numberInSurah": 11,
      "arabic": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ",
      "translation": "No! Indeed, these verses are a reminder;",
      "transliteration": "Kalla innaha tazkirah",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5770,
      "numberInSurah": 12,
      "arabic": "فَمَن شَآءَ ذَكَرَهُۥ",
      "translation": "So whoever wills may remember it.",
      "transliteration": "Faman shaa a zakarah",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5771,
      "numberInSurah": 13,
      "arabic": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ",
      "translation": "[It is recorded] in honored sheets,",
      "transliteration": "Fi suhufim mukar rama,",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5772,
      "numberInSurah": 14,
      "arabic": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ",
      "translation": "Exalted and purified,",
      "transliteration": "Marfoo'atim mutah hara,",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5773,
      "numberInSurah": 15,
      "arabic": "بِأَيْدِى سَفَرَةٍۢ",
      "translation": "[Carried] by the hands of messenger-angels,",
      "transliteration": "Bi'aidee safara",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5774,
      "numberInSurah": 16,
      "arabic": "كِرَامٍۭ بَرَرَةٍۢ",
      "translation": "Noble and dutiful.",
      "transliteration": "Kiraamim bararah.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5775,
      "numberInSurah": 17,
      "arabic": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ",
      "translation": "Cursed is man; how disbelieving is he.",
      "transliteration": "Qutilal-insanu maa akfarah.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5776,
      "numberInSurah": 18,
      "arabic": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
      "translation": "From what substance did He create him?",
      "transliteration": "Min aiyyi shai-in Khalaq",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5777,
      "numberInSurah": 19,
      "arabic": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "translation": "From a sperm-drop He created him and destined for him;",
      "transliteration": "Min nutfah; khalaqahu faqad-darah.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5778,
      "numberInSurah": 20,
      "arabic": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "translation": "Then He eased the way for him;",
      "transliteration": "Thummas sabeela yas-sarah",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5779,
      "numberInSurah": 21,
      "arabic": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
      "translation": "Then He causes his death and provides a grave for him.",
      "transliteration": "Thumma amatahu fa-aqbarah",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5780,
      "numberInSurah": 22,
      "arabic": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "translation": "Then when He wills, He will resurrect him.",
      "transliteration": "Thumma iza shaa-a ansharah",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5781,
      "numberInSurah": 23,
      "arabic": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
      "translation": "No! Man has not yet accomplished what He commanded him.",
      "transliteration": "Kalla lamma yaqdi maa amarah.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5782,
      "numberInSurah": 24,
      "arabic": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "translation": "Then let mankind look at his food -",
      "transliteration": "Falyanzuril insanu ilaa ta-amih",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5783,
      "numberInSurah": 25,
      "arabic": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا",
      "translation": "How We poured down water in torrents,",
      "transliteration": "Anna sabab nalmaa-a sabba.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5784,
      "numberInSurah": 26,
      "arabic": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا",
      "translation": "Then We broke open the earth, splitting [it with sprouts],",
      "transliteration": "Thumma sha qaqnal-arda shaqqa.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5785,
      "numberInSurah": 27,
      "arabic": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا",
      "translation": "And caused to grow within it grain",
      "transliteration": "Fa ambatna feeha habba",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5786,
      "numberInSurah": 28,
      "arabic": "وَعِنَبًۭا وَقَضْبًۭا",
      "translation": "And grapes and herbage",
      "transliteration": "Wa 'inabaw-wa qadba",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5787,
      "numberInSurah": 29,
      "arabic": "وَزَيْتُونًۭا وَنَخْلًۭا",
      "translation": "And olive and palm trees",
      "transliteration": "Wa zaitoonaw wanakh la'",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5788,
      "numberInSurah": 30,
      "arabic": "وَحَدَآئِقَ غُلْبًۭا",
      "translation": "And gardens of dense shrubbery",
      "transliteration": "Wa hadaa-iqa ghulba",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5789,
      "numberInSurah": 31,
      "arabic": "وَفَٰكِهَةًۭ وَأَبًّۭا",
      "translation": "And fruit and grass -",
      "transliteration": "Wa faki hataw-wa abba.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5790,
      "numberInSurah": 32,
      "arabic": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ",
      "translation": "[As] enjoyment for you and your grazing livestock.",
      "transliteration": "Mata'al-lakum wa li-an'amikum.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5791,
      "numberInSurah": 33,
      "arabic": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "translation": "But when there comes the Deafening Blast",
      "transliteration": "Faiza jaa-atis saakhah.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5792,
      "numberInSurah": 34,
      "arabic": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
      "translation": "On the Day a man will flee from his brother",
      "transliteration": "Yauma yafir-rul mar-u min akheeh",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5793,
      "numberInSurah": 35,
      "arabic": "وَأُمِّهِۦ وَأَبِيهِ",
      "translation": "And his mother and his father",
      "transliteration": "Wa ummihee wa abeeh",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5794,
      "numberInSurah": 36,
      "arabic": "وَصَٰحِبَتِهِۦ وَبَنِيهِ",
      "translation": "And his wife and his children,",
      "transliteration": "Wa sahi batihee wa baneeh.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5795,
      "numberInSurah": 37,
      "arabic": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ",
      "translation": "For every man, that Day, will be a matter adequate for him.",
      "transliteration": "Likul limri-im-minuhm yaumaa-izin shaa nuy-yughneeh",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5796,
      "numberInSurah": 38,
      "arabic": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ",
      "translation": "[Some] faces, that Day, will be bright -",
      "transliteration": "Wujoo huny-yauma-izim-musfira;",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5797,
      "numberInSurah": 39,
      "arabic": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ",
      "translation": "Laughing, rejoicing at good news.",
      "transliteration": "Dahi katum mustab shirah",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5798,
      "numberInSurah": 40,
      "arabic": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ",
      "translation": "And [other] faces, that Day, will have upon them dust.",
      "transliteration": "Wa wujoohuy yauma-izin 'alaiha ghabar a",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5799,
      "numberInSurah": 41,
      "arabic": "تَرْهَقُهَا قَتَرَةٌ",
      "translation": "Blackness will cover them.",
      "transliteration": "Tarhaquha qatarah.",
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5800,
      "numberInSurah": 42,
      "arabic": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
      "translation": "Those are the disbelievers, the wicked ones.",
      "transliteration": "Ulaa-ika humul-kafa ratul-fajarah.",
      "juz": 30,
      "manzil": 7,
