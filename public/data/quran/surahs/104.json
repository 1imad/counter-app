{
  "number": 104,
  "name": "سُورَةُ الهُمَزَةِ",
  "englishName": "Al-Humaza",
  "englishNameTranslation": "The Traducer",
  "revelationType": "Meccan",
  "numberOfAyahs": 9,
  "ayahs": [
    {
      "number": 6180,
      "numberInSurah": 1,
      "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ",
      "translation": "Woe to every scorner and mocker",
      "transliteration": "Wai lul-li kulli hu mazatil-lumaza",
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false,
      "urduTranslation": "ہر طعن آمیز اشارتیں کرنے والے چغل خور کی خرابی ہے"
    },
    {
      "number": 6181,
      "numberInSurah": 2,
      "arabic": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ",
      "translation": "Who collects wealth and [continuously] counts it.",
      "transliteration": "Al-lazi jama'a maalaw wa'addadah",
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false,
      "urduTranslation": "جو مال جمع کرتا اور اس کو گن گن کر رکھتا ہے"
    },
    {
      "number": 6182,
      "numberInSurah": 3,
      "arabic": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "translation": "He thinks that his wealth will make him immortal.",
      "transliteration": "Yahsabu anna maalahu akhladah",
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false,
      "urduTranslation": "(اور) خیال کرتا ہے کہ اس کا مال اس کی ہمیشہ کی زندگی کا موجب ہو گا"
    },
    {
      "number": 6183,
      "numberInSurah": 4,
      "arabic": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
      "translation": "No! He will surely be thrown into the Crusher.",
      "transliteration": "Kalla layum ba zanna fil hutamah",
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false,
      "urduTranslation": "ہر گز نہیں وہ ضرور حطمہ میں ڈالا جائے گا"
    },
    {
      "number": 6184,
      "numberInSurah": 5,
      "arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
      "translation": "And what can make you know what is the Crusher?",
      "transliteration": "Wa maa adraaka mal-hutamah",
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false,
      "urduTranslation": "اور تم کیا سمجھے حطمہ کیا ہے؟"
    },
    {
      "number": 6185,
      "numberInSurah": 6,
      "arabic": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
      "translation": "It is the fire of Allah, [eternally] fueled,",
      "transliteration": "Narul laahil-mooqada",
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false,
      "urduTranslation": "وہ خدا کی بھڑکائی ہوئی آگ ہے"
    },
    {
      "number": 6186,
      "numberInSurah": 7,
      "arabic": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
      "translation": "Which mounts directed at the hearts.",
      "transliteration": "Al latee tat tali'u 'alalafidah",
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false,
      "urduTranslation": "جو دلوں پر جا لپٹے گی"
    },
    {
      "number": 6187,
      "numberInSurah": 8,
      "arabic": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ",
      "translation": "Indeed, Hellfire will be closed down upon them",
      "transliteration": "Innaha 'alaihim moosada",
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false,
      "urduTranslation": "(اور) وہ اس میں بند کر دیئے جائیں گے"
    },
    {
      "number": 6188,
      "numberInSurah": 9,
      "arabic": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ",
      "translation": "In extended columns.",
      "transliteration": "Fee 'amadim-mu mad dadah",
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false,
      "urduTranslation": "(یعنی آگ کے) لمبے لمبے ستونوں میں"
    }
  ]
}